{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinni-star-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_API_ORIGIN": "https://tinni-star-api.mishrajii7991.workers.dev"
  },
  "assets": {
    "directory": "../tinni_owner_panel",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STAFF_AUTH",
        "class_name": "StaffAuthStore"
      },
      {
        "name": "FRUIT_GAME",
        "class_name": "FruitGameStore"
      },
      {
        "name": "FRUIT_PARTY",
        "class_name": "FruitPartyStore"
      },
      {
        "name": "ROOM_PRESENCE",
        "class_name": "RoomPresenceStore"
      },
      {
        "name": "APP_DIRECTORY",
        "class_name": "AppDirectoryStore"
      }
    ]
  },
  "exports": {
    "StaffAuthStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "FruitGameStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "FruitPartyStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RoomPresenceStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AppDirectoryStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
