{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinni-star-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../tinni_owner_panel",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/api/*"
    ]
  }
}
