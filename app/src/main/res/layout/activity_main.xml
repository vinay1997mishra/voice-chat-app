<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">

    <!-- Main screen: chat only -->
    <LinearLayout
        android:id="@+id/chatShell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/menuButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="☰"
                android:textSize="23sp"
                android:contentDescription="Open Anamika menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anamika"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Owner lock"
                    android:textColor="#AAB0BA"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ownerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pinInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Owner PIN"
                android:inputType="numberPassword"
                android:maxLength="12"
                android:textColor="#FFFFFF"
                android:textColorHint="#7F8792" />

            <Button
                android:id="@+id/unlockButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Unlock" />

            <Button
                android:id="@+id/forgetOwnerButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:visibility="gone"
                android:text="Lock" />
        </LinearLayout>

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="#101114"
            android:gravity="top|start"
            android:scrollbars="vertical"
            android:text="Anamika: Owner unlock ke baad yahin type ya bolkar baat kariye."
            android:textColor="#F2F3F5"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom|center_vertical"
            android:padding="8dp"
            android:orientation="horizontal"
            android:background="#191B20">

            <Button
                android:id="@+id/attachButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+"
                android:textSize="25sp"
                android:contentDescription="Add file or media" />

            <EditText
                android:id="@+id/commandInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:maxLines="5"
                android:gravity="center_vertical"
                android:hint="Message Anamika…"
                android:inputType="textCapSentences|textMultiLine"
                android:textDirection="firstStrong"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#7F8792"
                android:background="#252830" />

            <Button
                android:id="@+id/listenButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="🎤"
                android:contentDescription="Speak" />

            <Button
                android:id="@+id/runButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="➤"
                android:contentDescription="Send" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tap-outside dim layer -->
    <View
        android:id="@+id/menuDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <!-- Left drawer: every Anamika function lives here -->
    <ScrollView
        android:id="@+id/toolsPanel"
        android:layout_width="330dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:visibility="gone"
        android:fillViewport="true"
        android:background="#17191E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Anamika"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/toolsCloseButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="✕" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CREATE"
                android:textColor="#8F96A3"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingTop="10dp"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/imageCreatorMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Image / Photo Create &amp; Edit"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/internetCreatorButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Video Create &amp; Edit"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/premium3dButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cinematic 3D / 4D Studio"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/projectMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Projects"
                android:gravity="start|center_vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASSISTANT"
                android:textColor="#8F96A3"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/memoryMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memory &amp; Learning"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/voiceMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voice Profile"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/researchButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Research / Background Learning"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/languageStatusButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Languages &amp; Understanding"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/wakeListenButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="24×7 Hello Mika / Hello Anamika: ALWAYS ON"
                android:gravity="start|center_vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PHONE &amp; APPS"
                android:textColor="#8F96A3"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/remoteMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone Assistant Manager"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/pluginCenterButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plugins / App Control / Auto Audit"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/permissionSetupButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone Access &amp; Permissions"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/storageSetupButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Files / Storage Access"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/vaultMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Space / Vault"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/deviceInfoMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone Model &amp; Device Profile"
                android:gravity="start|center_vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DEVELOPER"
                android:textColor="#8F96A3"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/testLabButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Native App Test Lab"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/selfUpgradeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Self-Upgrade Workspace"
                android:gravity="start|center_vertical" />

            <Button
                android:id="@+id/secureSelfUpdateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Secure Self Update"
                android:gravity="start|center_vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="App / Website / Code Builder"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/developerPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:hint="Describe what to build"
                android:textColor="#FFFFFF"
                android:textColorHint="#7F8792" />

            <EditText
                android:id="@+id/referenceUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Optional reference URL / note"
                android:inputType="textUri"
                android:textColor="#FFFFFF"
                android:textColorHint="#7F8792" />

            <Button
                android:id="@+id/generateCodeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generate + Validate Code" />

            <Button
                android:id="@+id/saveProjectButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Verified Project" />

            <TextView
                android:id="@+id/developerOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:text="Developer output will appear here."
                android:textColor="#D6DAE1"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SYSTEM"
                android:textColor="#8F96A3"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/settingsMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Anamika / Phone Settings"
                android:gravity="start|center_vertical" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
