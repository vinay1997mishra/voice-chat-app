<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anamika AI"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Locked"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pinInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Owner PIN (4–12 digits)"
                android:inputType="numberPassword"
                android:maxLength="12" />

            <Button
                android:id="@+id/unlockButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set PIN" />
        </LinearLayout>

        <Button
            android:id="@+id/forgetOwnerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Forget Owner Login / Require PIN Again" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Talk to Anamika"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:background="#121212"
            android:gravity="top|start"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:text="Anamika: Owner unlock ke baad yahin type ya bolkar koi bhi command dijiye."
            android:textColor="#FFFFFF"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="top"
            android:hint="Message or command… e.g. WhatsApp kholo aur Vinay ko hello bhejo"
            android:minLines="3"
            android:maxLines="6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/runButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Send" />

            <Button
                android:id="@+id/listenButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎤 Mic" />
        </LinearLayout>

        <Button
            android:id="@+id/wakeListenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="24×7 Hello Mika / Hello Anamika: ALWAYS ON" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="After the first Owner setup, 24×7 Background Wake stays enabled automatically. You do not need to open Anamika first—say “Hello Mika” or “Hello Anamika”. The foreground service resumes best-effort after app reopen, reboot and app update. Android Force Stop or some OEM battery controls can still interrupt it."
            android:textSize="13sp" />

        <Button
            android:id="@+id/pluginCenterButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="App Control / Auto Audit Setup" />

        <Button
            android:id="@+id/testLabButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Native App Test Lab" />

        <Button
            android:id="@+id/premium3dButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Universal Cinematic 3D/4D Studio" />

        <Button
            android:id="@+id/internetCreatorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Internet Cinematic Creator" />

        <Button
            android:id="@+id/researchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Research / Learn from Visible Content" />

        <Button
            android:id="@+id/languageStatusButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Universal Language Status" />

        <Button
            android:id="@+id/selfUpgradeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prepare Self-Upgrade Workspace" />

        <Button
            android:id="@+id/secureSelfUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Secure Owner-Signed Self Update" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Developer / App Builder"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You can also simply type “video editing app banao…” in the main message box. This section shows detailed generated code/output."
            android:textSize="13sp" />

        <EditText
            android:id="@+id/developerPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="Detailed app/website/code request"
            android:minLines="4" />

        <EditText
            android:id="@+id/referenceUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Optional reference note/URL"
            android:inputType="textUri" />

        <Button
            android:id="@+id/generateCodeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate + Validate Offline" />

        <Button
            android:id="@+id/saveProjectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Verified Project Files" />

        <TextView
            android:id="@+id/developerOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="Developer output will appear here."
            android:textIsSelectable="true"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
