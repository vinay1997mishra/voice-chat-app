<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Anamika Image / Video Creator" android:textSize="26sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Image/video create, normal video→anime transform, aur story→anime video ke liye compatible HTTPS creator provider connect karein. Anime mode natural multi-character voices, lip-sync aur non-robotic voice treatment request karta hai. API key session-only hai; Anamika use save nahi karti."/>
  <EditText android:id="@+id/creatorPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minLines="4" android:gravity="top" android:hint="Example: black phoenix storm clouds se nikle, camera ke around circle kare, land kare, cinematic fire, premium animated-movie look"/>
  <EditText android:id="@+id/creatorReference" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Optional public reference image/video/app URL" android:inputType="textUri"/>
  <EditText android:id="@+id/creatorEndpoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Compatible creator API endpoint" android:inputType="textUri"/>
  <EditText android:id="@+id/creatorModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Provider model name (optional)"/>
  <EditText android:id="@+id/creatorApiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="API key (not saved)" android:inputType="textPassword"/>
  <Button android:id="@+id/creatorGenerate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Generate"/>
  <Button android:id="@+id/creatorLocal3d" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Offline Cinematic 3D Studio"/>
  <TextView android:id="@+id/creatorStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Ready." android:textIsSelectable="true"/>
 </LinearLayout>
</ScrollView>
