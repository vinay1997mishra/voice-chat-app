<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Anamika Plugin Center" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Only apps YOU check here become plugins. Anamika will never auto-enable an app, never force a plugin choice, and never add another app without your selection." />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Disclosure: App Control works only on owner-enabled plugins. If an app is not enabled here, Anamika skips control/audit for it. Visible UI actions and blueprint records remain owner-commanded." />
        <CheckBox android:id="@+id/accessibilityConsent" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="I understand and want to enable App Control" />
        <Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Open Accessibility Settings" />
        <TextView android:id="@+id/selectedPlugin" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Selected: none" android:textStyle="bold" />
        <EditText android:id="@+id/pluginCommand" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minLines="3" android:gravity="top" android:hint="Example: tap Search then type Anamika AI" />
        <Button android:id="@+id/runPluginCommand" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Open Selected App + Run Command" />
        <Button android:id="@+id/refreshPlugins" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Refresh App Plugins" />
        <Button android:id="@+id/startInspection" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Auto Check All Safe Functions + Build Blueprint" />
        <Button android:id="@+id/stopInspection" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Stop Auto Audit + Save Blueprint" />
        <TextView android:id="@+id/inspectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Inspection: idle" android:textIsSelectable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Available apps" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/pluginList" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
